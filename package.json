{
  "name": "typemonkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "productName": "TypeMonkey",
  "icon": "/public/monkey.png",
"scripts": {
  "dev": "vite",
  "start:electron": "wait-on http://localhost:5173 && electron src/electron/main.js",
  "start": "concurrently -n \"FRONT,ELECTRON\" -c \"cyan,magenta\" \"npm run dev\" \"npm run start:electron\""
}
,
  "dependencies": {
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "pg": "^8.15.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.2",
    "sass-embedded": "^1.87.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "vite": "^6.3.1",
    "wait-on": "^8.0.3"
  }
}
